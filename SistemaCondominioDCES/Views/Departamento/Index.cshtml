@model List<SistemaCondominioDCES.Models.Departamento>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Departamentos";
}

<div class="admin-layout">

    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-brand">
                <img src="~/Content/images/img_dash.png" alt="Logo" class="logo-icon" />
                <div>
                    <h3>CONSORCIO DCES</h3>
                    <p>Gestión de Condominios</p>
                </div>
            </div>
        </div>
        <ul class="sidebar-menu">
            <li class="sidebar-item">
                <a href="/Home/Dashboard"><span>🏠 Inicio</span></a>
            </li>
            <li class="sidebar-item">
                <a href="/Propietario"><span>👥 Propietarios</span></a>
            </li>
            <li class="sidebar-item active">
                <a href="/Departamento"><span>🏢 Departamentos</span></a>
            </li>
            <li class="sidebar-item">
                <a href="/Pago/Index"><span>💰 Pagos</span></a>
            </li>
            <li class="sidebar-item">
                <a href="/Incidencia"><span>⚠️ Incidencias</span></a>
            </li>
            <li class="sidebar-item">
                <a href="/Reserva/Index"><span>📅 Reservas</span></a>
            </li>
            <li class="sidebar-item">
                <a href="~/reportes/Index.cshtml"><span>📈 Reportes</span></a>
            </li>
            <li class="sidebar-item">
                <a href="/comunicado/Index"><span>📢 Comunicados</span></a>
            </li>
            <li class="sidebar-item">
                <a href="/configuracion/Index"><span>⚙ Configuración</span></a>
            </li>
        </ul>
        <div class="sidebar-footer">
            <a href="/Home/Logout" class="sidebar-logout"><span>🚪 Cerrar Sesión</span></a>
        </div>
    </aside>

    <main class="main-content">
        <header class="top-header">
            <span class="header-breadcrumb">Departamentos</span>
            <div class="user-role-box">Rol: @Session["Rol"]</div>
        </header>

        <div class="dashboard-viewport">
            <div class="table-container-card">
                <div class="table-header-flex">
                    <h2>Gestión de Departamentos</h2>
                    <a href="/Departamento/Create" class="btn-add-new">+ Nuevo Departamento</a>
                </div>

                <div class="table-responsive-wrapper">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>Torre</th>
                                <th>Nº Depto</th>
                                <th>Piso</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.NombreTorre</td>
                                    <td>@item.Numero</td>
                                    <td>@item.Piso</td>
                                    <td>
                                        @if (item.Estado)
                                        {
                                            <span class="status-badge active">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge inactive">Inactivo</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/Departamento/Edit/@item.IdDepartamento" class="btn-table-action edit">✏️ Editar</a>
                                        <a href="/Departamento/Delete/@item.IdDepartamento" class="btn-table-action delete" onclick="return confirm('¿Desea desactivar este departamento?');">🗑️ Eliminar</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <footer class="dashboard-footer">
            © 2026 Consorcio DCES. Todos los derechos reservados.
        </footer>
    </main>

</div>
