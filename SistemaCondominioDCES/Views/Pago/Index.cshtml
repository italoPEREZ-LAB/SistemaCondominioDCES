@model List<SistemaCondominioDCES.Models.Pago>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Pagos";
}

<div class="admin-layout">

    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-brand">
                <img src="~/Content/images/img_dash.png" alt="Logo" class="logo-icon" />
                <div><h3>CONSORCIO DCES</h3><p>Gestión de Condominios</p></div>
            </div>
        </div>
        <ul class="sidebar-menu">
            <li class="sidebar-item"><a href="/Home/Dashboard"><span>🏠 Inicio</span></a></li>
            <li class="sidebar-item"><a href="/Propietario"><span>👥 Propietarios</span></a></li>
            <li class="sidebar-item"><a href="/Departamento"><span>🏢 Departamentos</span></a></li>
            <li class="sidebar-item active"><a href="/Pago/Index"><span>💰 Pagos</span></a></li>
            <li class="sidebar-item"><a href="/Incidencia"><span>⚠️ Incidencias</span></a></li>
            <li class="sidebar-item"><a href="/Reserva/Index"><span>📅 Reservas</span></a></li>
            <li class="sidebar-item"><a href="/reportes/Index"><span>📈 Reportes</span></a></li>
            <li class="sidebar-item"><a href="/comunicado/Index"><span>📢 Comunicados</span></a></li>
            <li class="sidebar-item"><a href="/configuracion/Index"><span>⚙️ Configuración</span></a></li>
        </ul>
        <div class="sidebar-footer">
            <a href="/Home/Logout" class="sidebar-logout"><span>🚪 Cerrar Sesión</span></a>
        </div>
    </aside>

    <main class="main-content">
        <header class="top-header">
            <span class="header-breadcrumb">Pagos</span>
            <div class="user-role-box">Rol: @Session["Rol"]</div>
        </header>

        <div class="dashboard-viewport">
            <div class="table-container-card">
                <div class="table-header-flex">
                    <h2>Gestión de Pagos</h2>
                    <a href="/Pago/Create" class="btn-add-new">+ Registrar Pago</a>
                </div>

                <div class="table-responsive-wrapper">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Propietario</th>
                                <th>Monto (S/.)</th>
                                <th>Fecha Pago</th>
                                <th>Método</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.IdPago</strong></td>
                                    <td>@item.NombrePropietario</td>
                                    <td>S/. @item.MontoPagado.ToString("0.00")</td>
                                    <td>@item.FechaPago.ToString("dd/MM/yyyy")</td>
                                    <td>@item.MetodoPago</td>
                                    <td>
                                        @if (item.Estado == "Pagado")
                                        {
                                            <span class="status-badge active">Pagado</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge inactive">Pendiente</span>
                                        }
                                    </td>
                                    <td style="text-align:center;">
                                        <a href="/Pago/Edit/@item.IdPago"
                                           style="background:#fff4d6; color:#f59e0b; padding:8px 14px; border-radius:8px; text-decoration:none; font-weight:600; margin-right:8px;">
                                            ✏️ Editar
                                        </a>

                                        <a href="/Pago/Delete/@item.IdPago"
                                           onclick="return confirm('¿Desea eliminar este pago?');"
                                           style="background:#fde2e2; color:#ef4444; padding:8px 14px; border-radius:8px; text-decoration:none; font-weight:600;">
                                            🗑 Eliminar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <footer class="dashboard-footer">© 2026 Consorcio DCES. Todos los derechos reservados.</footer>
    </main>

</div>
