@model SistemaCondominioDCES.Models.Pago

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Editar Pago";
}

<div class="admin-layout">

    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-brand">
                <img src="~/Content/images/img_dash.png" alt="Logo" class="logo-icon" />
                <div><h3>CONSORCIO DCES</h3><p>Gestión de Condominios</p></div>
            </div>
        </div>
        <ul class="sidebar-menu">
            <li class="sidebar-item"><a href="/Home/Dashboard"><span>🏠 Inicio</span></a></li>
            <li class="sidebar-item"><a href="/Propietario"><span>👥 Propietarios</span></a></li>
            <li class="sidebar-item"><a href="/Departamento"><span>🏢 Departamentos</span></a></li>
            <li class="sidebar-item active"><a href="/Pago/Index"><span>💰 Pagos</span></a></li>
            <li class="sidebar-item"><a href="/Incidencia"><span>⚠️ Incidencias</span></a></li>
            <li class="sidebar-item"><a href="/Reserva/Index"><span>📅 Reservas</span></a></li>
            <li class="sidebar-item"><a href="/reportes/Index"><span>📈 Reportes</span></a></li>
            <li class="sidebar-item"><a href="/comunicado/Index"><span>📢 Comunicados</span></a></li>
            <li class="sidebar-item"><a href="/configuracion/Index"><span>⚙️ Configuración</span></a></li>
        </ul>
        <div class="sidebar-footer">
            <a href="/Home/Logout" class="sidebar-logout"><span>🚪 Cerrar Sesión</span></a>
        </div>
    </aside>

    <main class="main-content">
        <header class="top-header">
            <span class="header-breadcrumb">Editar Pago</span>
            <div class="user-role-box">Rol: @Session["Rol"]</div>
        </header>

        <div class="dashboard-viewport">

            @if (ViewBag.Error != null)
            {
                <div class="form-alert-error">⚠️ @ViewBag.Error</div>
            }

            <div class="form-card">
                <div class="form-card-breadcrumb">
                    <a href="/Pago/Index">Pagos</a> › Editar Pago
                </div>

                <form method="post" action="@Url.Action("Edit", "Pago")">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="IdPago" value="@Model.IdPago" />
                    <input type="hidden" name="IdRecibo" value="@Model.IdRecibo" />

                    <div class="form-field-row">
                        <label class="form-field-label">Monto (S/.) <span class="required">*</span></label>
                        <div class="form-field-input">
                            <input type="number" step="0.01" name="MontoPagado" value="@Model.MontoPagado" class="form-input-custom" required />
                        </div>
                    </div>

                    <div class="form-field-row">
                        <label class="form-field-label">Fecha de Pago <span class="required">*</span></label>
                        <div class="form-field-input">
                            <input type="date" name="FechaPago" value="@Model.FechaPago.ToString("yyyy-MM-dd")" class="form-input-custom" required />
                        </div>
                    </div>

                    <div class="form-field-row">
                        <label class="form-field-label">Método de Pago <span class="required">*</span></label>
                        <div class="form-field-input">
                            <select name="MetodoPago" class="form-select-custom" required>
                                <option value="">Seleccionar método</option>
                                <option value="Efectivo" @(Model.MetodoPago == "Efectivo" ? "selected" : "")>Efectivo</option>
                                <option value="Transferencia" @(Model.MetodoPago == "Transferencia" ? "selected" : "")>Transferencia</option>
                                <option value="Yape" @(Model.MetodoPago == "Yape" ? "selected" : "")>Yape</option>
                                <option value="Plin" @(Model.MetodoPago == "Plin" ? "selected" : "")>Plin</option>
                                <option value="Tarjeta" @(Model.MetodoPago == "Tarjeta" ? "selected" : "")>Tarjeta</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-field-row">
                        <label class="form-field-label">Estado <span class="required">*</span></label>
                        <div class="form-field-input">
                            <select name="Estado" class="form-select-custom" required>
                                <option value="Pagado" @(Model.Estado == "Pagado" ? "selected" : "")>Pagado</option>
                                <option value="Pendiente" @(Model.Estado == "Pendiente" ? "selected" : "")>Pendiente</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-form-submit">💾 Actualizar Pago</button>
                        <a href="/Pago/Index" class="btn-form-cancel">✕ Cancelar</a>
                    </div>

                </form>
            </div>
        </div>

        <footer class="dashboard-footer">© 2026 Consorcio DCES. Todos los derechos reservados.</footer>
    </main>

</div>