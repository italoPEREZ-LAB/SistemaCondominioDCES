@model List<SistemaCondominioDCES.Models.Incidencia>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Incidencias";
}

<div class="admin-layout">
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-brand">
                <img src="~/Content/images/img_dash.png" alt="Logo" class="logo-icon" />
                <div>
                    <h3>CONSORCIO DCES</h3>
                    <p>Gestion de Condominios</p>
                </div>
            </div>
        </div>
        <ul class="sidebar-menu">
            <li class="sidebar-item"><a href="/Home/Dashboard"><span>🏠 Inicio</span></a></li>
            <li class="sidebar-item"><a href="/Propietario"><span>👥 Propietarios</span></a></li>
            <li class="sidebar-item"><a href="/Departamento"><span>🏢 Departamentos</span></a></li>
            <li class="sidebar-item"><a href="/Pago/Index"><span>💰 Pagos</span></a></li>
            <li class="sidebar-item active"><a href="/Incidencia"><span>⚠️ Incidencias</span></a></li>
            <li class="sidebar-item"><a href="/Reserva/Index"><span>📅 Reservas</span></a></li>
            <li class="sidebar-item"><a href="/reportes/Index"><span>📈 Reportes</span></a></li>
            <li class="sidebar-item"><a href="/comunicado/Index"><span>📢 Comunicados</span></a></li>
            <li class="sidebar-item"><a href="/configuracion/Index"><span>⚙️ Configuración</span></a></li>
        </ul>
        <div class="sidebar-footer">
            <a href="/Home/Logout" class="sidebar-logout"><span>🚪 Cerrar Sesión</span></a>
        </div>
    </aside>

    <main class="main-content">
        <header class="top-header">
            <span class="header-breadcrumb">Incidencias</span>
            <div class="user-role-box">Rol: @Session["Rol"]</div>
        </header>

        <div class="dashboard-viewport">
            <div class="table-container-card">
                <div class="table-header-flex">
                    <h2>Gestion de Incidencias</h2>
                    <a href="/Incidencia/Create" class="btn-add-new">+ Nueva Incidencia</a>
                </div>
                <div class="table-responsive-wrapper">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Titulo</th>
                                <th>Descripcion</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.IdIncidencia</strong></td>
                                    <td>@item.Titulo</td>
                                    <td>@item.Descripcion</td>
                                    <td>@item.FechaReporte.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (item.Estado == "Abierto")
                                        {
                                            <span class="status-badge inactive">@item.Estado</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge active">@item.Estado</span>
                                        }
                                    </td>
                                    <td>
                                        @using (Html.BeginForm("ActualizarEstado", "Incidencia", FormMethod.Post))
                                        {
                                            @Html.Hidden("id", item.IdIncidencia)
                                            if (item.Estado == "Abierto")
                                            {
                                                @Html.Hidden("estado", "Cerrado")
                                                <button type="submit" class="btn-table-action edit">Cerrar</button>
                                            }
                                            else
                                            {
                                                @Html.Hidden("estado", "Abierto")
                                                <button type="submit" class="btn-table-action edit">Reabrir</button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <footer class="dashboard-footer">
            © 2026 Consorcio DCES. Todos los derechos reservados.
        </footer>
    </main>
</div>