@model SistemaCondominioDCES.Models.Reserva

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Nueva Reserva";
    var usuarios = ViewBag.Usuarios as List<SelectListItem> ?? new List<SelectListItem>();
    var areas = ViewBag.Areas as List<SelectListItem> ?? new List<SelectListItem>();
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        ⚠️ @ViewBag.Error
    </div>
}

<div class="admin-layout">

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-brand">
                <img src="~/Content/images/img_dash.png" alt="Logo" class="logo-icon" />
                <div>
                    <h3>CONSORCIO DCES</h3>
                    <p>Gestión de Condominios</p>
                </div>
            </div>
        </div>
        <ul class="sidebar-menu">
            <li class="sidebar-item"><a href="/Home/Dashboard"><span>🏠 Inicio</span></a></li>
            <li class="sidebar-item"><a href="/Propietario"><span>👥 Propietarios</span></a></li>
            <li class="sidebar-item"><a href="/Departamento"><span>🏢 Departamentos</span></a></li>
            <li class="sidebar-item"><a href="/Pago/Index"><span>💰 Pagos</span></a></li>
            <li class="sidebar-item"><a href="/Incidencia"><span>⚠️ Incidencias</span></a></li>
            <li class="sidebar-item active"><a href="/Reserva/Index"><span>📅 Reservas</span></a></li>
            <li class="sidebar-item"><a href="/reportes/Index"><span>📈 Reportes</span></a></li>
            <li class="sidebar-item"><a href="/comunicado/Index"><span>📢 Comunicados</span></a></li>
            <li class="sidebar-item"><a href="/configuracion/Index"><span>⚙️ Configuración</span></a></li>
        </ul>
        <div class="sidebar-footer">
            <a href="/Home/Logout" class="sidebar-logout"><span>🚪 Cerrar Sesión</span></a>
        </div>
    </aside>

    <!-- CONTENIDO -->
    <main class="main-content">
        <header class="top-header">
            <span class="header-breadcrumb">Reserva de Áreas Comunes</span>
            <div class="user-role-box">Rol: @Session["Rol"]</div>
        </header>

        <div class="dashboard-viewport">

            @if (ViewBag.Error != null)
            {
                <div class="form-alert-error">⚠️ @ViewBag.Error</div>
            }

            <div class="form-card">
                <div class="form-card-breadcrumb">
                    <a href="/Reserva/Index">Reservas</a> › Nueva Reserva
                </div>

                <form method="post">

                    <div class="form-field-row">
                        <label class="form-field-label">Área Común <span class="required">*</span></label>
                        <div class="form-field-input">
                            <select name="IdAreaComun" class="form-select-custom" required>
                                <option value="">Seleccionar área</option>
                                @foreach (var a in areas)
                                {
                                    <option value="@a.Value">@a.Text</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-field-row">
                        <label class="form-field-label">Fecha <span class="required">*</span></label>
                        <div class="form-field-input">
                            <input type="date" name="FechaReserva" class="form-input-custom" required />
                        </div>
                    </div>

                    <div class="form-field-row">
                        <label class="form-field-label">Hora Inicio <span class="required">*</span></label>
                        <div class="form-field-input">
                            <input type="time" name="HoraInicio" class="form-input-custom" required />
                        </div>
                    </div>

                    <div class="form-field-row">
                        <label class="form-field-label">Hora Fin <span class="required">*</span></label>
                        <div class="form-field-input">
                            <input type="time" name="HoraFin" class="form-input-custom" required />
                        </div>
                    </div>

                    <div class="form-field-row">
                        <label class="form-field-label">Solicitante <span class="required">*</span></label>
                        <div class="form-field-input">
                            <select name="IdUsuario" class="form-select-custom" required>
                                <option value="">Seleccionar propietario</option>
                                @foreach (var u in usuarios)
                                {
                                    <option value="@u.Value">@u.Text</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-field-row">
                        <label class="form-field-label">Observación</label>
                        <div class="form-field-input">
                            <textarea name="Observacion" class="form-textarea-custom" placeholder="Observación (opcional)..." rows="3"></textarea>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-form-submit">💾 Reservar</button>
                        <a href="/Reserva/Index" class="btn-form-cancel">✕ Cancelar</a>
                    </div>

                </form>
            </div>
        </div>

        <footer class="dashboard-footer">
            © 2026 Consorcio DCES. Todos los derechos reservados.
        </footer>
    </main>

</div>
